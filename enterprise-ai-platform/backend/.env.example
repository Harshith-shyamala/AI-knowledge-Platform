EAKP_ENVIRONMENT=local
EAKP_SERVICE_NAME=enterprise-ai-platform-api
EAKP_API_VERSION=v1
EAKP_LOG_LEVEL=INFO
EAKP_CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]
EAKP_DATABASE_URL=postgresql+psycopg://eakp:eakp@localhost:5432/eakp
EAKP_AUTO_CREATE_SCHEMA=false
EAKP_JWT_SECRET_KEY=change-me-in-production
EAKP_ACCESS_TOKEN_EXPIRE_MINUTES=30
EAKP_REFRESH_TOKEN_EXPIRE_DAYS=14
EAKP_STORAGE_ROOT=.local/storage
EAKP_MAX_UPLOAD_SIZE_BYTES=26214400
EAKP_READINESS_DEPENDENCIES_ENABLED=false
